<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature
        android:name="android.hardware.type.automotive"
        android:required="true" />

    <!-- 브레이크 페달 상태: Pleos Vehicle SDK Brake (normal 권한) -->
    <uses-permission android:name="pleos.car.permission.CAR_DRIVE" />
    <!-- 차량 속도: AAOS PERF_VEHICLE_SPEED (런타임 요청) -->
    <uses-permission android:name="android.car.permission.CAR_SPEED" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.BeatLane">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|uiMode|density"
            android:launchMode="singleTask">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- 주행 중 화면이므로 AAOS 주행 중 UX 제한에서 차단되지 않게 한다. -->
            <meta-data
                android:name="distractionOptimized"
                android:value="true" />
        </activity>
    </application>

</manifest>
